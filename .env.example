AGENTD_RUNNER=1
AGENTD_REPO=/srv/agentd/repos/project
AGENTD_STATE_DIR=/srv/agentd/state
AGENTD_WORKTREES=/srv/agentd/worktrees/tasks
AGENTD_LOGS=/srv/agentd/logs/tasks
AGENTD_CONTROL_SOCKET=/run/agentd/control.sock
AGENTD_CODEX_BIN=/var/lib/agentd/.local/bin/codex
AGENTD_CLAUDE_BIN=/var/lib/agentd/.local/bin/claude
# Hardened profile: requires Linux bubblewrap and a successful native preflight.
AGENTD_STRICT_WORKERS=1
AGENTD_ENABLED_ADAPTERS=claude
AGENTD_EDITING=1
AGENTD_EDIT_ADAPTERS=claude
