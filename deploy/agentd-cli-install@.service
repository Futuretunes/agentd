[Unit]
Description=AgentD approved CLI install %i
# Started only by the administration helper for a validated approval id.
# Runs outside the helper sandbox because installing writes under /opt and
# the service-user symlink; the command is fixed and the instance is only an id.
ConditionPathExists=/var/lib/agentd-cli/%i.json

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /opt/agentd/scripts/run_approved_cli.py --id %i --config /etc/agentd/update.json
TimeoutStartSec=10min
UMask=0077
