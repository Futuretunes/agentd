[Unit]
Description=AgentD apply gateway hardening profile
# Started only by the administration helper when gatewayHardening is not yet set.
# Re-runs verify-only when the profile is already installed.

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /opt/agentd/scripts/apply_gateway_hardening.py --config /etc/agentd/update.json
TimeoutStartSec=15min
UMask=0077
